<Window x:Class="_2026_WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2026_WpfApp2"
        mc:Ignorable="d"
        Title="WPF飲料訂購ver3" Height="471" Width="832">
	<Grid Margin="5,5,5,5" Background="#FF9FBF97">
		<Grid.RowDefinitions>
			<RowDefinition Height="50"/>
			<RowDefinition Height="240"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="533"/>
			<ColumnDefinition MinWidth="100"/>
		</Grid.ColumnDefinitions>
		<GroupBox Header="eat in/take away">
			<StackPanel Background="#FF4B8857" Grid.ColumnSpan="2" Orientation="Horizontal">
				<RadioButton Checked="RadioButton_Checked" Content="eat in" FontSize="14" FontWeight="Bold" Margin="80,0,0,0" VerticalContentAlignment="Center" x:Name="RadioButton1"/>
				<RadioButton Checked="RadioButton_Checked" Content="take away" FontSize="14" FontWeight="Bold" Margin="80,0,0,0" VerticalContentAlignment="Center" x:Name="RadioButton2"/>
			</StackPanel>
		</GroupBox>
		<StackPanel Background="#FFDEEDBC" Grid.Row="1" Orientation="Vertical" x:Name="DrinkMenuStackPanel">
		</StackPanel>
		<TextBlock Background="#FFEFCFB9" FontSize="14" Grid.ColumnSpan="2" Grid.Row="2" Grid.RowSpan="1" Padding="10,10,10,10" TextWrapping="Wrap" x:Name="ResultTextBlock"/>
		<Button Click="OrderButton_Click" Content="order" FontSize="16" Grid.Column="1" Grid.Row="1" Margin="34,68,34,135" MinWidth="50" x:Name="OrderButton" Background="#FF4B8857"/>
	</Grid>
</Window>