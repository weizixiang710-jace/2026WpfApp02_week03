<Window x:Class="_2026WpfApp02_week03.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="飲料訂購ver2" Height="600" Width="900">

    <Grid Background="#FF77A88D">
        <!-- 1. 版面網格切割：3 列 2 欄 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="638"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <StackPanel Orientation="Horizontal" Background="#FF598987">
            <GroupBox Header="內用/外帶">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RadioButton1" Content="內用" Margin="50,0,0,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RadioButton2" Content="外帶" Margin="80,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- 3. 第二列左側 (Row 1, Column 0)：飲料品項選擇區（先保留一項） -->
        <StackPanel x:Name="StackPanel_Drinks" Orientation="Vertical" Grid.Row="1" Background="#FF67A482" Margin="0,0,0,32">

            
            <StackPanel Orientation="Horizontal" Height="36" Background="#FF678F8D" Margin="0,3,0,3">
                <CheckBox Content="紅茶大杯" FontSize="14" VerticalContentAlignment="Center" Width="100" Margin="10,0,0,0"/>
                <Label Content="60元" FontSize="14" VerticalContentAlignment="Center" Width="60"/>
                <Slider x:Name="Slider01" Minimum="0" Maximum="20" Width="150" VerticalAlignment="Center" IsSnapToTickEnabled="True"/>
                <Label Content="{Binding Value, ElementName=Slider01}" FontSize="14" VerticalContentAlignment="Center" Width="40" Margin="10,0,0,0"/>
                <Label Content="杯" FontSize="14" VerticalContentAlignment="Center"/>
            </StackPanel>

            
            <StackPanel Orientation="Horizontal" Height="36" Background="#FF678F8D" Margin="0,3,0,3">
                <CheckBox Content="紅茶小杯" FontSize="14" VerticalContentAlignment="Center" Width="100" Margin="10,0,0,0"/>
                <Label Content="40元" FontSize="14" VerticalContentAlignment="Center" Width="60"/>
                <Slider x:Name="Slider02" Minimum="0" Maximum="20" Width="150" VerticalAlignment="Center" IsSnapToTickEnabled="True"/>
                <Label Content="{Binding Value, ElementName=Slider02}" FontSize="14" VerticalContentAlignment="Center" Width="40" Margin="10,0,0,0"/>
                <Label Content="杯" FontSize="14" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Height="36" Background="#FF678F8D" Margin="0,3,0,3">
                <CheckBox Content="綠茶小杯" FontSize="14" VerticalContentAlignment="Center" Width="100" Margin="10,0,0,0"/>
                <Label Content="40元" FontSize="14" VerticalContentAlignment="Center" Width="60"/>
                <Slider x:Name="Slider03" Minimum="0" Maximum="20" Width="150" VerticalAlignment="Center" IsSnapToTickEnabled="True"/>
                <Label Content="{Binding Value, ElementName=Slider03}" FontSize="14" VerticalContentAlignment="Center" Width="40" Margin="10,0,0,0"/>
                <Label Content="杯" FontSize="14" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Height="36" Background="#FF678F8D" Margin="0,3,0,3">
                <CheckBox Content="奶茶小杯" FontSize="14" VerticalContentAlignment="Center" Width="100" Margin="10,0,0,0"/>
                <Label Content="40元" FontSize="14" VerticalContentAlignment="Center" Width="60"/>
                <Slider x:Name="Slider04" Minimum="0" Maximum="20" Width="150" VerticalAlignment="Center" IsSnapToTickEnabled="True"/>
                <Label Content="{Binding Value, ElementName=Slider04}" FontSize="14" VerticalContentAlignment="Center" Width="40" Margin="10,0,0,0"/>
                <Label Content="杯" FontSize="14" VerticalContentAlignment="Center"/>
            </StackPanel>

        </StackPanel>

        <!-- 4. 第二列右側 (Row 1, Column 1)：訂購按鈕 (OrderButton) -->
        <Button x:Name="OrderButton" Content="訂購" Grid.Row="1" Grid.Column="1" Margin="37,193,29,0" Height="40" VerticalAlignment="Top" Background="#FFFF6670" Click="OrderButton_Click_1"/>

        <!-- 5. 第三列 (Row 2)：顯示訂購結果明細的 TextBlock -->
        <TextBlock x:Name="txtReceipt" Grid.Row="2" Grid.ColumnSpan="2" Margin="10,4,10,0" TextWrapping="Wrap" FontSize="14" Background="#FFEDDA85" MinHeight="80"/>

    </Grid>
</Window>